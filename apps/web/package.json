{
  "name": "@4ce/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "icons": "node ../../tools/icons/generate.mjs",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/i18n/generated --strategy custom-storage baseLocale --no-emit-readme",
    "predev": "npm run icons && npm run i18n",
    "dev": "vite dev",
    "prebuild": "npm run icons && npm run i18n",
    "build": "vite build",
    "preview": "vite preview",
    "precheck": "npm run icons && npm run i18n",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "pretest": "npm run icons && npm run i18n",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint:design": "node ../../tools/design-lint/check.mjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@internationalized/date": "3.12.4",
    "bits-ui": "2.19.5",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "2.26.0",
    "@inlang/plugin-message-format": "4.4.5",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
