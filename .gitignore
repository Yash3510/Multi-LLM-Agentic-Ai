# Secrets: only .env.example is committed.
.env
.env.*
!.env.example

# Build outputs
node_modules/
.venv/
.svelte-kit/
build/
dist/
__pycache__/
*.py[cod]
*.egg-info/

# Tool caches
.pytest_cache/
.ruff_cache/

# Logs
*.log

# Run-time data: the SQLite database and anything 4CE writes while running.
/data/

# Obsidian per-person files; only the three shared settings are committed.
.obsidian/*
!.obsidian/app.json
!.obsidian/core-plugins.json
!.obsidian/templates.json

# Web app: test output and generated sources (rebuilt by npm scripts)
coverage/
test-results/
playwright-report/
apps/web/src/lib/ui/icons/generated/
apps/web/src/lib/i18n/generated/
*.inlang/*
!*.inlang/settings.json

# OS files
.DS_Store
