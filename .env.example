# Copy to .env (git-ignored) and replace every change-me value.
# 4CE reads FOURCE_* variables (core/common/README.md); the bundled services read theirs
# through deploy/compose/core.yml.

# The bundled services. The URLs below must carry the same passwords.
FOURCE_POSTGRES_PASSWORD=change-me
FOURCE_REDIS_PASSWORD=change-me
FOURCE_GRAFANA_ADMIN_PASSWORD=change-me

FOURCE_DATABASE_URL=postgresql://fource:change-me@localhost:5432/fource
FOURCE_REDIS_URL=redis://:change-me@localhost:6379/0

# Object storage: these are also MinIO's root credentials in development.
# MinIO needs a secret of at least 8 characters.
FOURCE_S3_ENDPOINT=http://localhost:9000
FOURCE_S3_ACCESS_KEY=fource
FOURCE_S3_SECRET_KEY=change-me
FOURCE_S3_BUCKET=fource

FOURCE_DATA_DIR=data
FOURCE_OFFLINE=true
