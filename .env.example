# Copy to .env (git-ignored) and replace every change-me value; `just setup` does it for you
# with fresh secrets. 4CE reads FOURCE_* variables (core/common/README.md).

FOURCE_SECRET_KEY=change-me
FOURCE_ORG=default
FOURCE_TOKEN_TTL_MINUTES=480

# The bundled services (just services). Keep these above the URLs that use them: a variable
# reference is filled in only from lines earlier in the file.
FOURCE_POSTGRES_PASSWORD=change-me
FOURCE_POSTGRES_APP_PASSWORD=change-me
FOURCE_REDIS_PASSWORD=change-me
FOURCE_GRAFANA_ADMIN_PASSWORD=change-me

# The database: SQLite in data/ unless set. For PostgreSQL (just services), uncomment both.
# FOURCE_DATABASE_URL=postgresql+psycopg://fource_app:${FOURCE_POSTGRES_APP_PASSWORD}@localhost:5432/fource
# FOURCE_DATABASE_ADMIN_URL=postgresql+psycopg://fource:${FOURCE_POSTGRES_PASSWORD}@localhost:5432/fource

# Object storage: these are also MinIO's root credentials in development.
FOURCE_S3_ENDPOINT=http://localhost:9000
FOURCE_S3_ACCESS_KEY=fource
FOURCE_S3_SECRET_KEY=change-me
FOURCE_S3_BUCKET=fource

FOURCE_DATA_DIR=data
FOURCE_OFFLINE=true
