{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fource:schema:rule-pack:draft-1",
  "title": "4CE Rule Pack, spec v1",
  "description": "Draft 1. Authored rules with the clause that decides each verdict. Covers the v1 rule types; membership, aggregate, trend, require_evidence and cross arrive in Phase 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack", "title", "source", "authored_by", "effective_from", "parameters", "rules",
    "missing_reading", "tests"
  ],
  "properties": {
    "pack": {
      "description": "<pack-id>/<rule-pack-id>, so rule packs from different packs never collide.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "source": {
      "description": "The rulebook the rules come from. Packs carry clause references and limits, never the rulebook's text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "revision", "owner", "licence_note"],
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "licence_note": { "type": "string", "minLength": 1 }
      }
    },
    "authored_by": { "type": "string", "minLength": 1 },
    "approved_by": { "description": "Required before activation.", "type": "string", "minLength": 1 },
    "effective_from": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/local_id" },
          "label": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/band_rule" },
          { "$ref": "#/$defs/enum_rule" },
          { "$ref": "#/$defs/presence_rule" },
          { "$ref": "#/$defs/expression_rule" },
          { "$ref": "#/$defs/date_rule" },
          { "$ref": "#/$defs/authority_rule" }
        ]
      }
    },
    "missing_reading": {
      "description": "The verdict when a reading is missing. Never PASS.",
      "enum": ["NO DATA", "REVIEW", "FAIL"]
    },
    "tests": {
      "description": "Every rule pack carries tests; a pack with a failing test cannot be activated.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["readings", "expect"],
        "properties": {
          "readings": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/local_id" },
            "additionalProperties": { "type": ["number", "string", "boolean"] }
          },
          "expect": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "enum": ["PASS", "REVIEW", "FAIL", "NO DATA"] }
          }
        }
      }
    }
  },
  "$defs": {
    "local_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "rule_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "quantity": {
      "description": "A number in the parameter's unit, or a value with its unit, e.g. \"9.5 mm\".",
      "oneOf": [{ "type": "number" }, { "type": "string", "minLength": 1 }]
    },
    "verdict": { "enum": ["PASS", "REVIEW", "FAIL"] },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "clause"],
      "properties": {
        "verdict": { "$ref": "#/$defs/verdict" },
        "clause": { "type": "string", "minLength": 1 },
        "disposition": { "type": "string", "minLength": 1 }
      }
    },
    "band_rule": {
      "description": "A numeric value against ordered ranges; the first band that matches decides.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter", "type", "bands"],
      "properties": {
        "id": { "$ref": "#/$defs/rule_id" },
        "parameter": { "$ref": "#/$defs/local_id" },
        "type": { "const": "band" },
        "bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verdict", "clause"],
            "properties": {
              "below": { "$ref": "#/$defs/quantity" },
              "max": { "$ref": "#/$defs/quantity" },
              "above": { "$ref": "#/$defs/quantity" },
              "min": { "$ref": "#/$defs/quantity" },
              "else": { "const": true },
              "verdict": { "$ref": "#/$defs/verdict" },
              "clause": { "type": "string", "minLength": 1 },
              "disposition": { "type": "string", "minLength": 1 }
            },
            "oneOf": [
              { "required": ["below"] },
              { "required": ["max"] },
              { "required": ["above"] },
              { "required": ["min"] },
              { "required": ["else"] }
            ]
          }
        }
      }
    },
    "enum_rule": {
      "description": "A category against allowed values.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter", "type", "values"],
      "properties": {
        "id": { "$ref": "#/$defs/rule_id" },
        "parameter": { "$ref": "#/$defs/local_id" },
        "type": { "const": "enum" },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "verdict", "clause"],
            "properties": {
              "value": { "type": ["string", "number"] },
              "verdict": { "$ref": "#/$defs/verdict" },
              "clause": { "type": "string", "minLength": 1 },
              "disposition": { "type": "string", "minLength": 1 }
            }
          }
        },
        "else": { "$ref": "#/$defs/outcome" }
      }
    },
    "presence_rule": {
      "description": "Whether something was observed: a mark, a signature, a required section.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter", "type", "present", "absent"],
      "properties": {
        "id": { "$ref": "#/$defs/rule_id" },
        "parameter": { "$ref": "#/$defs/local_id" },
        "type": { "enum": ["presence", "absence"] },
        "present": { "$ref": "#/$defs/outcome" },
        "absent": { "$ref": "#/$defs/outcome" }
      }
    },
    "expression_rule": {
      "description": "A formula over observations, run by the safe evaluator (never eval).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter", "type", "expr", "pass", "fail"],
      "properties": {
        "id": { "$ref": "#/$defs/rule_id" },
        "parameter": { "$ref": "#/$defs/local_id" },
        "type": { "const": "expression" },
        "expr": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/local_id" },
          "additionalProperties": { "$ref": "#/$defs/quantity" }
        },
        "pass": { "$ref": "#/$defs/outcome" },
        "fail": { "$ref": "#/$defs/outcome" }
      }
    },
    "date_rule": {
      "description": "Validity, deadlines, ages and intervals: the parameter's date against a reference date plus an optional ISO 8601 offset.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter", "type", "compare", "reference", "pass", "fail"],
      "properties": {
        "id": { "$ref": "#/$defs/rule_id" },
        "parameter": { "$ref": "#/$defs/local_id" },
        "type": { "const": "date" },
        "compare": { "enum": ["before", "on_or_before", "after", "on_or_after"] },
        "reference": {
          "description": "run_date, or another parameter's id.",
          "$ref": "#/$defs/local_id"
        },
        "offset": { "type": "string", "pattern": "^-?P(?!$)([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?$" },
        "pass": { "$ref": "#/$defs/outcome" },
        "fail": { "$ref": "#/$defs/outcome" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver_role", "clause"],
      "properties": {
        "max": { "$ref": "#/$defs/quantity" },
        "else": { "const": true },
        "category": { "type": "string", "minLength": 1 },
        "approver_role": { "type": "string", "minLength": 1 },
        "clause": { "type": "string", "minLength": 1 }
      },
      "oneOf": [{ "required": ["max"] }, { "required": ["else"] }]
    },
    "authority_rule": {
      "description": "Who may approve, from an amount and a category; the first row that matches decides.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter", "type", "matrix"],
      "properties": {
        "id": { "$ref": "#/$defs/rule_id" },
        "parameter": { "$ref": "#/$defs/local_id" },
        "type": { "const": "authority" },
        "matrix": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/authority" } }
      }
    }
  }
}
