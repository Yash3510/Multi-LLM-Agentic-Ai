# 4CE sovereign configuration
# Copy to the repo root as `.env` before starting the backend.

# --- Identity -------------------------------------------------------------
WEBUI_NAME=4CE
WEBUI_SECRET_KEY=change-me-before-the-demo
WEBUI_AUTH=true

# --- Local inference (LM Studio / Bionic Studio, OpenAI-compatible) -------
OPENAI_API_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
ENABLE_OLLAMA_API=false

# --- Local RAG ------------------------------------------------------------
# Embeddings are served by the same local server, so no model is ever
# downloaded from HuggingFace and OFFLINE_MODE stays safe to enable.
VECTOR_DB=chroma
RAG_EMBEDDING_ENGINE=openai
RAG_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
RAG_OPENAI_API_BASE_URL=http://localhost:1234/v1
RAG_OPENAI_API_KEY=lm-studio
CONTENT_EXTRACTION_ENGINE=

# --- Sovereignty ----------------------------------------------------------
OFFLINE_MODE=true
ENABLE_VERSION_UPDATE_CHECK=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_OTEL=false
ENABLE_WEB_SEARCH=false

# --- Code execution -------------------------------------------------------
# Both built-ins are disabled: the browser-side Pyodide interpreter is weaker
# than the 4CE Sovereign Sandbox tool and would give judges a second, less
# defensible execution path to ask about.
ENABLE_CODE_INTERPRETER=false
ENABLE_CODE_EXECUTION=false

# --- First-run experience ----------------------------------------------
# Replaces the upstream consumer suggestions (kids' art, the Roman Empire).
DEFAULT_PROMPT_SUGGESTIONS=[{"title":["Draft an approval note","from an inspection report"],"content":"Read the attached inspection report, pull out the key findings with their measured values, and draft an approval note as a Word document."},{"title":["Check readings against the SOP","and give a fit-for-service verdict"],"content":"Assess these inspection readings against SOP-MEC-014 and tell me the disposition, citing the clause that decided each one."},{"title":["Read a scanned document","and extract the measured values"],"content":"Read this scanned document and list every measured value it contains, with the parameter each one belongs to."},{"title":["Write and run code","in the isolated sandbox"],"content":"Write a Python function that computes the remaining wall thickness margin from a measured and a retirement thickness, then run it in the sandbox to verify it."},{"title":["Prove nothing leaves the premises","audit the running configuration"],"content":"Audit this system for anything that could send data outside the premises and show me the result."},{"title":["Summarise a procedure","from the local knowledge base"],"content":"Summarise what our standard operating procedures require for mechanical seal leakage, citing the clauses you used."}]

# --- Dev-mode static assets -------------------------------------------
# The backend clears its own static directory on every start and refills it
# from FRONTEND_BUILD_DIR/static. Without a production build that source is
# missing, so the directory is left stripped and icons 404. Pointing it at
# the repo's static/ makes static/static/ the source, which is where the 4CE
# assets already live. A real `npm run build` supersedes this.
# FRONTEND_BUILD_DIR=/absolute/path/to/repo/static

# Speech-to-text stays on the machine: a blank engine runs faster-whisper
# locally. Chrome and Edge implement the browser Web Speech API by streaming
# audio to Google/Microsoft, so "web" would quietly break the air-gap claim.
# Pre-cache the weights once while online, before OFFLINE_MODE is set:
#   python -c "from faster_whisper import WhisperModel; WhisperModel('base', device='cpu', compute_type='int8', download_root='backend/data/cache/whisper/models')"
AUDIO_STT_ENGINE=
WHISPER_MODEL=base

# Features the workbench does not use. Left on, they are surface area a
# reviewer can wander into and find half-configured.
ENABLE_CALENDAR=False
ENABLE_AUTOMATIONS=False
ENABLE_CHANNELS=False
ENABLE_EASTER_EGGS=False
